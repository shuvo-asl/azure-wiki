# Azure DevOps organization URL, e.g. https://dev.azure.com/your-org
ADO_ORG_URL=https://dev.azure.com/your-org

# Project name or id that contains the wiki
ADO_PROJECT=your-project

# Wiki name or id (the project wiki). Often "<project>.wiki"
ADO_WIKI=your-project.wiki

# Personal Access Token with Wiki (Read & Write) scope
ADO_PAT=

# Root path under which sprints live in the wiki
WIKI_ROOT_PATH=/Sprint Logs

# Port the app listens on
PORT=8080

# When true, renders + logs the markdown WITHOUT writing to the wiki
DRY_RUN=true
